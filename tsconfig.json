{
  "compilerOptions": {
    "target": "ES5",
    "lib": ["ES5"],
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false
  },
  "include": [
    "trakt.js",
    "src/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "libs",
    "views"
  ]
}
